<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZenithSniffer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/LiteNetLib/LiteNetLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Zenith.Protocol\Zenith.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sniffersettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
