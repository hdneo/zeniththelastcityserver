<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZenithServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <ProjectReference Include="../../shared/LiteNetLib/LiteNetLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Zenith.Protocol\Zenith.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="ClientData\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\data\item_catalog-56557.json" Link="ClientData\item_catalog-56557.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
